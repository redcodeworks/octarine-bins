# The dx binaries image, ghcr.io/redcodeworks/octarine-bins-dx (.github/workflows/binaries-dx.yml): binaries only the dx image of octarine-os needs.
# No binary component yet: the assemble stage writes an EMPTY /COMPONENTS (zero components = no binary to install) and an empty BUILDINFO. The image also carries the dev package list(s) and their installers under /packages: dev.txt (the developer package list), install.sh, install-copr.sh.
# Build: `just build octarine-bins-dx:dev dev unknown dx` (context: this directory; --build-context lib=src/lib is the shared helpers, installer=installer the shared package installers). To add a component, see dx/README.md.
ARG BUILDER

# ---- component stages go here, one per component (see src/Containerfile for the pattern: FROM ${BUILDER} AS <name>, COPY --from=lib . /binaries/lib, COPY <name> /binaries/<name>, build, stage.sh)

# ---- assemble: the same assembler as the base image; --allow-empty is what lets a list without components through, drop it once there is one
FROM ${BUILDER} AS assemble
# COPY --from=<stage> /out /out/<name> for each component goes here
COPY components.tsv /
COPY --from=lib assemble.sh /
RUN mkdir -p /out && /assemble.sh --allow-empty /out /components.tsv
# after assemble.sh: it refuses a directory that is not a component
# /packages: this image's lists (dx/packages/) and the shared installers (installer/), side by side; the contract with octarine-os is in CLAUDE.md
COPY packages /out/packages
COPY --from=installer . /out/packages/

FROM scratch

# Build values passed by CI (podman build --build-arg ...); no secrets
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown

COPY --from=assemble /out /

LABEL maintainer="redcodeworks/octarine-bins" \
      org.opencontainers.image.authors="redcodeworks" \
      org.opencontainers.image.vendor="redcodeworks" \
      org.opencontainers.image.title="octarine-bins-dx" \
      org.opencontainers.image.description="The octarine-os dx image inputs: developer package list and installers (no binary component yet)" \
      org.opencontainers.image.url="https://github.com/redcodeworks/octarine-bins" \
      org.opencontainers.image.source="https://github.com/redcodeworks/octarine-bins" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
