#!/usr/bin/env python3
"""Fake skopeo: `inspect` and `copy` against a directory of tags (STATE, one file per tag holding the manifest), with failure modes picked by MODE and a call log in LOG."""
import json
import os
import shutil
import sys
from pathlib import Path

args = sys.argv[1:]
if "LOG" in os.environ:
    with open(os.environ["LOG"], "a") as log:
        log.write("skopeo " + " ".join(args) + "\n")

count_file = Path(os.environ["COUNT"]) if "COUNT" in os.environ else None
calls = (int(count_file.read_text()) if count_file and count_file.exists() else 0) + 1
if count_file:
    count_file.write_text(str(calls))

mode = os.environ.get("MODE", "ok")  # ok | absent | down | flaky (fails twice, then works) | empty
# DIGEST_LAG=N: the first N reads of an image BY DIGEST fail the way GHCR answered in CI, although the tag that gave the digest was just read fine (counted in DIGEST_LAG_FILE)
lag_file = Path(os.environ["DIGEST_LAG_FILE"]) if "DIGEST_LAG_FILE" in os.environ else None
state = Path(os.environ["STATE"]) if "STATE" in os.environ else None


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


if args[0] == "inspect":
    flag, ref = args[-2], args[-1].removeprefix("docker://")
    if lag_file and "@sha256:" in ref:
        seen = int(lag_file.read_text()) if lag_file.exists() else 0
        lag_file.write_text(str(seen + 1))
        if seen < int(os.environ["DIGEST_LAG"]):
            fail(f'time="2026-11-17T04:56:00Z" level=fatal msg="Error parsing image name \\"docker://{ref}\\": reading manifest {ref.split("@")[1]} in ghcr.io/o/i: manifest unknown"')
    if mode == "absent":
        fail("Error: reading manifest x in ghcr.io/o/i: manifest unknown")
    if mode == "down":
        fail("Get https://ghcr.io: 503 Service Unavailable")
    if mode == "flaky" and calls <= 2:
        fail("dial tcp: i/o timeout")
    if mode == "empty":
        sys.exit(0)
    if flag == "--config":
        print(json.dumps({"config": {"Labels": {"org.opencontainers.image.revision": os.environ.get("REV", "")}}}))
    elif state is None:
        sys.stdout.write('{"manifest":1}')
    else:
        manifest = state / ref.rsplit(":", 1)[-1]
        if not manifest.exists():
            fail("manifest unknown")
        sys.stdout.buffer.write(manifest.read_bytes())
elif args[0] == "copy" and state is not None:
    shutil.copy(state / "testing", state / "latest")
